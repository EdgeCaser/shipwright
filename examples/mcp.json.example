{
  "mcpServers": {
    "linear": {
      "type": "http",
      "url": "https://linear.app/mcp",
      "headers": {
        "Authorization": "Bearer YOUR_LINEAR_API_KEY"
      }
    },
    "notion": {
      "type": "http",
      "url": "https://mcp.notion.com/mcp",
      "headers": {
        "Authorization": "Bearer YOUR_NOTION_API_KEY"
      }
    },
    "slack": {
      "type": "http",
      "url": "https://mcp.slack.com/mcp",
      "headers": {
        "Authorization": "Bearer YOUR_SLACK_BOT_TOKEN"
      }
    },
    "amplitude": {
      "type": "http",
      "url": "https://mcp.amplitude.com/mcp",
      "headers": {
        "Authorization": "Bearer YOUR_AMPLITUDE_API_KEY"
      }
    }
  }
}
