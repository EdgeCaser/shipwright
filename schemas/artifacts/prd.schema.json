{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shipwright PRD Artifact",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "mode",
    "depth",
    "metadata",
    "decision_frame",
    "unknowns",
    "pass_fail_readiness",
    "evidence",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "2.0.0"
      ]
    },
    "artifact_type": {
      "type": "string",
      "enum": [
        "prd"
      ],
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "fast",
        "rigorous"
      ],
      "minLength": 1
    },
    "depth": {
      "type": "string",
      "enum": [
        "quick",
        "light",
        "standard",
        "deep"
      ],
      "minLength": 1
    },
    "metadata": {
      "type": "object",
      "required": [
        "title",
        "status",
        "authors",
        "updated_at"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "in-review",
            "approved",
            "exploratory-draft"
          ],
          "minLength": 1
        },
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "updated_at": {
          "type": "string",
          "minLength": 1
        },
        "approval_record": {
          "type": "object",
          "required": ["human_identity", "decision_ref", "decided_at"],
          "properties": {
            "human_identity": { "type": "string", "minLength": 1 },
            "decision_ref": { "type": "string", "minLength": 1 },
            "decided_at": { "type": "string", "minLength": 1, "pattern": "^\\d{4}-\\d{2}-\\d{2}T" }
          }
        }
      },
      "if": { "properties": { "status": { "const": "approved" } } },
      "then": { "required": ["approval_record"] }
    },
    "decision_frame": {
      "type": "object",
      "required": [
        "recommendation",
        "tradeoff",
        "confidence",
        "owner",
        "decision_date",
        "revisit_trigger"
      ],
      "properties": {
        "recommendation": {
          "type": "string",
          "minLength": 1
        },
        "tradeoff": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "decision_date": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?:\\d{4}-\\d{2}-\\d{2}|\\[TBD, requires: [^\\]]+\\])$"
        },
        "revisit_trigger": {
          "type": "string",
          "minLength": 1
        },
        "hypothesis": {
          "type": "boolean"
        },
        "assumption": {
          "type": "boolean"
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "pass_fail_readiness": {
      "type": "object",
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL"
          ],
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "evidence_id",
          "kind",
          "source_ref",
          "confidence",
          "supports"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "metric",
              "interview",
              "research",
              "experiment",
              "document",
              "assumption"
            ],
            "minLength": 1
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "minLength": 1
          },
          "supports": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "challenge_resolution": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "state",
          "note"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "type": "string",
            "enum": [
              "resolved",
              "waived",
              "deferred"
            ],
            "minLength": 1
          },
          "note": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": ["critical", "moderate", "minor", "low"]
          },
          "waiver_reason": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "human_decision": {
            "type": "object",
            "required": ["human_identity", "decision_ref", "decided_at"],
            "properties": {
              "human_identity": { "type": "string", "minLength": 1 },
              "decision_ref": { "type": "string", "minLength": 1 },
              "decided_at": { "type": "string", "minLength": 1, "pattern": "^\\d{4}-\\d{2}-\\d{2}T" }
            }
          }
        },
        "if": { "properties": { "state": { "const": "waived" } } },
        "then": { "required": ["owner", "waiver_reason", "human_decision"] }
      }
    },
    "payload": {
      "type": "object",
      "required": [
        "problem_statement",
        "customer_evidence_ids",
        "success_metrics",
        "scope",
        "open_questions",
        "target_segment"
      ],
      "properties": {
        "problem_statement": {
          "type": "object",
          "required": [
            "problem_id",
            "text"
          ],
          "properties": {
            "problem_id": {
              "type": "string",
              "minLength": 1
            },
            "text": {
              "type": "string",
              "minLength": 1
            },
            "hypothesis": {
              "type": "boolean"
            },
            "assumption": {
              "type": "boolean"
            }
          }
        },
        "customer_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "success_metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "metric_id",
              "name",
              "unit",
              "timeframe",
              "evidence_ids",
              "baseline",
              "target"
            ],
            "properties": {
              "metric_id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "segment": {
                "type": "string",
                "minLength": 1
              },
              "unit": {
                "type": "string",
                "minLength": 1
              },
              "timeframe": {
                "type": "string",
                "minLength": 1
              },
              "baseline": {
                "type": [
                  "number",
                  "string"
                ],
                "minLength": 1
              },
              "target": {
                "type": [
                  "number",
                  "string"
                ],
                "minLength": 1
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "hypothesis": {
                "type": "boolean"
              },
              "assumption": {
                "type": "boolean"
              },
              "explanation": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "scope": {
          "type": "object",
          "required": [
            "in",
            "out"
          ],
          "properties": {
            "in": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "out": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "target_segment": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
