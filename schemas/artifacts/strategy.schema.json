{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shipwright Strategy Artifact",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "mode",
    "depth",
    "metadata",
    "decision_frame",
    "unknowns",
    "pass_fail_readiness",
    "evidence",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "2.0.0"
      ]
    },
    "artifact_type": {
      "type": "string",
      "enum": [
        "strategy"
      ],
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "fast",
        "rigorous"
      ],
      "minLength": 1
    },
    "depth": {
      "type": "string",
      "enum": [
        "quick",
        "light",
        "standard",
        "deep"
      ],
      "minLength": 1
    },
    "metadata": {
      "type": "object",
      "required": [
        "title",
        "status",
        "authors",
        "updated_at"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "in-review",
            "approved",
            "exploratory-draft"
          ],
          "minLength": 1
        },
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "updated_at": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "decision_frame": {
      "type": "object",
      "required": [
        "recommendation",
        "tradeoff",
        "confidence",
        "owner",
        "decision_date",
        "revisit_trigger"
      ],
      "properties": {
        "recommendation": {
          "type": "string",
          "minLength": 1
        },
        "tradeoff": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "decision_date": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "revisit_trigger": {
          "type": "string",
          "minLength": 1
        },
        "hypothesis": {
          "type": "boolean"
        },
        "assumption": {
          "type": "boolean"
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "pass_fail_readiness": {
      "type": "object",
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL"
          ],
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "evidence_id",
          "kind",
          "source_ref",
          "confidence",
          "supports"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "metric",
              "interview",
              "research",
              "experiment",
              "document",
              "assumption"
            ],
            "minLength": 1
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "minLength": 1
          },
          "supports": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "challenge_resolution": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "state",
          "note"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "type": "string",
            "enum": [
              "resolved",
              "waived",
              "deferred"
            ],
            "minLength": 1
          },
          "note": {
            "type": "string",
            "minLength": 1
          },
          "waiver_reason": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "payload": {
      "type": "object",
      "required": [
        "vision",
        "context",
        "bets",
        "boundaries",
        "review_cadence",
        "primary_segment"
      ],
      "properties": {
        "vision": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "type": "object",
          "required": [
            "current_state"
          ],
          "properties": {
            "current_state": {
              "type": "object",
              "required": [
                "product_stage"
              ],
              "properties": {
                "product_stage": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "primary_segment": {
          "type": "string",
          "minLength": 1
        },
        "bets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "bet_id",
              "name",
              "thesis",
              "assumptions",
              "investment_level",
              "success_metric",
              "kill_criteria",
              "evidence_ids"
            ],
            "properties": {
              "bet_id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "thesis": {
                "type": "string",
                "minLength": 1
              },
              "assumptions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "investment_level": {
                "type": "string",
                "minLength": 1
              },
              "success_metric": {
                "type": "object",
                "required": [
                  "metric_id",
                  "name",
                  "unit",
                  "timeframe",
                  "baseline",
                  "target"
                ],
                "properties": {
                  "metric_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "segment": {
                    "type": "string",
                    "minLength": 1
                  },
                  "unit": {
                    "type": "string",
                    "minLength": 1
                  },
                  "timeframe": {
                    "type": "string",
                    "minLength": 1
                  },
                  "baseline": {
                    "type": [
                      "number",
                      "string"
                    ],
                    "minLength": 1
                  },
                  "target": {
                    "type": [
                      "number",
                      "string"
                    ],
                    "minLength": 1
                  },
                  "explanation": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "kill_criteria": {
                "type": "string",
                "minLength": 1
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "hypothesis": {
                "type": "boolean"
              },
              "assumption": {
                "type": "boolean"
              }
            }
          },
          "maxItems": 4
        },
        "boundaries": {
          "type": "object",
          "required": [
            "not_doing"
          ],
          "properties": {
            "not_doing": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "review_cadence": {
          "type": "object",
          "required": [
            "weekly",
            "monthly",
            "quarterly"
          ],
          "properties": {
            "weekly": {
              "type": "string",
              "minLength": 1
            },
            "monthly": {
              "type": "string",
              "minLength": 1
            },
            "quarterly": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
